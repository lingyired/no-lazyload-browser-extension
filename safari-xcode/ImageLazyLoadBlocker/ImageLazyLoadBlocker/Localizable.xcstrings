        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "पॉपअप खोलें और “वर्तमान साइट हटाएं” दबाएँ"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Otvorite skočni prozor i kliknite „Ukloni trenutnu stranicu”"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nyisd meg a felugró ablakot, és kattints a(z) „Jelenlegi oldal eltávolítása” gombra"
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Buka popup dan klik “Hapus Situs Saat Ini”"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Apri il popup e fai clic su «Rimuovi sito corrente»"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ポップアップを開き「現在のサイトを削除」をクリックします"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "팝업을 열고 ‘현재 사이트 제거’를 클릭하세요"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Åpne popup-vinduet og klikk på «Fjern gjeldende nettsted»"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Open de pop-up en klik op ‘Huidige site verwijderen’"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Otwórz okno podręczne i kliknij „Usuń bieżącą stronę”"
          }
        },
        "ps": {
          "stringUnit": {
            "state": "needs_review",
            "value": "پاپ اپ پرانیستل او «اوسنی سایټ لرې کړئ» کېکاږئ"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Abra a janela pop-up e clique em «Remover Site Atual»"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Deschide fereastra pop-up și apasă „Elimină site-ul curent”"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Откройте всплывающее окно и нажмите «Удалить Текущий Сайт»"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Otvorte vyskakovacie okno a kliknite na „Odstrániť aktuálnu stránku“"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Öppna popup-fönstret och klicka på ”Ta bort aktuell webbplats”"
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "เปิดป๊อปอัปแล้วคลิก “ลบเว็บไซต์ปัจจุบัน”"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Açılır pencereyi açın ve «Geçerli Siteyi Kaldır» düğmesine tıklayın"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Відкрийте спливне вікно та натисніть «Видалити поточний сайт»"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "needs_review",
            "value": "پاپ اپ کھولیں اور «موجودہ سائٹ ہٹائیں» دبائیں"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mở cửa sổ bật lên và nhấn “Xóa trang hiện tại”"
          }
        }
      }

{
  "sourceLanguage": "en",
  "strings": {
    "appName": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No Lazyload"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "No Lazyload"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "No Lazyload"
          }
        }
      }
    },
    "appSubtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Loads every image on the sites you enable in Safari."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在你于 Safari 中启用的网站上，立即加载所有图片。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在你於 Safari 中啟用的網站上，立即載入所有圖片。"
          }
        }
      }
    },
    "enableExtensionHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable the extension to use No Lazyload in Safari."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要在 Safari 中使用 No Lazyload，需要先启用扩展。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "若要在 Safari 中使用 No Lazyload，請先啟用擴充功能。"
          }
        }
      }
    },
    "enableStep1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Click the button below to open Safari extension settings"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点下面的按钮打开 Safari 扩展设置"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點下面的按鈕開啟 Safari 擴充功能設定"
          }
        }
      }
    },
    "enableStep2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on No Lazyload in the list"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在列表里勾选 No Lazyload"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在列表裡勾選 No Lazyload"
          }
        }
      }
    },
    "enableStep3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Back in Safari, the toolbar button appears"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "回到 Safari，工具栏上就会出现按钮"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "回到 Safari，工具列上就會出現按鈕"
          }
        }
      }
    },
    "enableStepsTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To enable it"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启用步骤"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "啟用步驟"
          }
        }
      }
    },
    "extensionDisabled": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not Enabled"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未启用"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "未啟用"
          }
        }
      }
    },
    "extensionEnabled": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enabled"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已启用"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已啟用"
          }
        }
      }
    },
    "extensionReady": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No Lazyload is ready."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "No Lazyload 已就绪。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "No Lazyload 已就緒。"
          }
        }
      }
    },
    "extensionStatusUnknown": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Status unavailable"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "状态不可用"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "狀態無法取得"
          }
        }
      }
    },
    "extensionStatusUnknownHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't read the Safari extension status. Open Safari Settings to check it."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取 Safari 扩展状态。请打开 Safari 设置检查。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法讀取 Safari 擴充功能狀態。請開啟 Safari 設定檢查。"
          }
        }
      }
    },
    "howToUse": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How to use"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用方法"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用方式"
          }
        }
      }
    },
    "modeCompatibilityHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scrolls the page to the bottom to trigger loading. Use it only when Standard mode does not work"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动滚动页面到底部触发加载。只在标准模式没效果时使用"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "自動捲動頁面到底部觸發載入。只在標準模式沒效果時使用"
          }
        }
      }
    },
    "modeCompatibilityName": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Compatibility"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "兼容模式"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "相容模式"
          }
        }
      }
    },
    "modeStandardHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Blocks lazy loading directly. The default, and works on most sites"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "直接拦截懒加载。默认方式，绝大多数网站用这个"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "直接攔截延遲載入。預設方式，絕大多數網站用這個"
          }
        }
      }
    },
    "modeStandardName": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Standard"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "标准模式"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "標準模式"
          }
        }
      }
    },
    "modesTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Two modes"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "两种模式"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "兩種模式"
          }
        }
      }
    },
    "openSafariSettings": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Safari Settings"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开 Safari 设置"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟 Safari 設定"
          }
        }
      }
    },
    "privacyNote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No Lazyload only acts on the websites you enable. Other websites are untouched"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "No Lazyload 只作用于你启用的网站，其它网站不做任何改动"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "No Lazyload 只作用於你啟用的網站，其它網站不做任何改動"
          }
        }
      }
    },
    "safariExtension": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Safari Extension"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Safari 扩展"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Safari 擴充功能"
          }
        }
      }
    },
    "stepEnableSite": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Click “Add Current Site” — images load at once"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点「添加当前网站」，图片会立即全部加载"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點一下「加入目前網站」，圖片會立即全部載入"
          }
        }
      }
    },
    "stepOpenExtension": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Click the No Lazyload toolbar button"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击 No Lazyload 工具栏按钮"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點一下 No Lazyload 工具列按鈕"
          }
        }
      }
    },
    "stepOpenWebsite": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open a website in Safari"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Safari 中打开一个网站"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Safari 中開啟一個網站"
          }
        }
      }
    },
    "troubleshoot1Body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Make sure the site is enabled in the popup. If it is, try Compatibility mode. Still nothing? Use Refresh Page"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先确认这个网站已在 popup 里启用；再试试兼容模式；还不行就用 popup 底部的「刷新页面」"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "先確認這個網站已在 popup 裡啟用；再試試相容模式；還不行就用 popup 底部的「重新整理頁面」"
          }
        }
      }
    },
    "troubleshoot1Title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Images still not loading?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "图片还是没加载？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "圖片還是沒載入？"
          }
        }
      }
    },
    "troubleshoot2Body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check Safari → Settings → Extensions and make sure No Lazyload is on"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "到 Safari → 设置 → 扩展，确认 No Lazyload 已勾选"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "到 Safari → 設定 → 擴充功能，確認 No Lazyload 已勾選"
          }
        }
      }
    },
    "troubleshoot2Title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No toolbar button?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "工具栏上没有按钮？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "工具列上沒有按鈕？"
          }
        }
      }
    },
    "troubleshoot3Body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open the popup and click “Remove Current Site”"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开 popup，点「移除当前网站」"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟 popup，點一下「移除目前網站」"
          }
        }
      }
    },
    "troubleshoot3Title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Want to turn a site off?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "想停用某个网站？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "想停用某個網站？"
          }
        }
      }
    },
    "troubleshootingTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Troubleshooting"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "遇到问题？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "遇到問題？"
          }
        }
      }
    },
    "versionFormat": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Version %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "版本 %@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "版本 %@"
          }
        }
      }
    },
    "·": {}
  },
  "version": "1.0"
}

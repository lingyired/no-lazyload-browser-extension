    "extensionStatusUnknownHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't read the Safari extension status. Open Safari Settings to check it."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取 Safari 扩展状态。请打开 Safari 设置检查。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法讀取 Safari 擴充功能狀態。請開啟 Safari 設定檢查。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تعذّر قراءة حالة إضافة Safari. افتح إعدادات Safari للتحقق."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Състоянието на разширението на Safari не можа да бъде прочетено. Проверете в настройките на Safari."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "No s’ha pogut llegir l’estat de l’extensió del Safari. Comprova-ho a la configuració del Safari."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Stav rozšíření Safari se nepodařilo načíst. Zkontrolujte jej v nastavení Safari."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kunne ikke læse Safari-udvidelsens status. Åbn Safari-indstillingerne for at kontrollere."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Der Status der Safari-Erweiterung konnte nicht gelesen werden. Öffne die Safari-Einstellungen, um ihn zu prüfen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Δεν ήταν δυνατή η ανάγνωση της κατάστασης της επέκτασης Safari. Έλεγξέ την στις ρυθμίσεις του Safari."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "No se pudo leer el estado de la extensión de Safari. Abre los ajustes de Safari para comprobarlo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "needs_review",
            "value": "وضعیت افزونه Safari خوانده نشد. برای بررسی، تنظیمات Safari را باز کنید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Safari-laajennuksen tilaa ei voitu lukea. Tarkista se avaamalla Safarin asetukset."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Impossible de lire l’état de l’extension Safari. Ouvrez les réglages de Safari pour le vérifier."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "לא ניתן לקרוא את סטטוס התוסף של Safari. בדוק בהגדרות Safari."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Safari एक्सटेंशन की स्थिति पढ़ी नहीं जा सकी। जाँचने के लिए Safari सेटिंग खोलें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nije bilo moguće pročitati status proširenja Safarija. Provjerite u postavkama Safarija."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nem sikerült beolvasni a Safari bővítmény állapotát. Ellenőrizd a Safari beállításaiban."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tidak dapat membaca status ekstensi Safari. Periksa di pengaturan Safari."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Impossibile leggere lo stato dell’estensione Safari. Apri le impostazioni di Safari per verificarlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Safari 機能拡張の状態を読み取れませんでした。Safari の設定で確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Safari 확장 기능 상태를 읽을 수 없습니다. Safari 설정에서 확인하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kunne ikke lese statusen til Safari-utvidelsen. Åpne Safari-innstillingene for å sjekke."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "De status van de Safari-extensie kon niet worden gelezen. Open de Safari-instellingen om het te controleren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nie udało się odczytać stanu rozszerzenia Safari. Otwórz ustawienia Safari, aby to sprawdzić."
          }
        },
        "ps": {
          "stringUnit": {
            "state": "needs_review",
            "value": "د Safari د غځونکي حالت ونه لوستل شو. د کتنې لپاره د Safari تنظیمات پرانیستل."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Não foi possível ler o status da extensão do Safari. Abra os ajustes do Safari para verificar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Starea extensiei Safari nu a putut fi citită. Deschide setările Safari pentru a o verifica."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Не удалось прочитать состояние расширения Safari. Проверьте в настройках Safari."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Stav rozšírenia Safari sa nepodarilo načítať. Skontrolujte ho v nastaveniach Safari."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kunde inte läsa Safari-tilläggets status. Öppna Safari-inställningarna för att kontrollera."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "อ่านสถานะส่วนขยาย Safari ไม่ได้ กรุณาตรวจสอบในการตั้งค่า Safari"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Safari uzantısının durumu okunamadı. Kontrol etmek için Safari ayarlarını açın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Не вдалося прочитати стан розширення Safari. Перевірте в налаштуваннях Safari."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Safari ایکسٹینشن کی حالت پڑھی نہیں جا سکی۔ جانچنے کے لیے Safari ترتیبات کھولیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Không đọc được trạng thái tiện ích Safari. Hãy kiểm tra trong cài đặt Safari."
          }
        }
      }
    },

        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "若要在 Safari 中使用 No Lazyload，請先啟用擴充功能。"
          }
        }
      }
    },
    "extensionReady": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No Lazyload is ready."

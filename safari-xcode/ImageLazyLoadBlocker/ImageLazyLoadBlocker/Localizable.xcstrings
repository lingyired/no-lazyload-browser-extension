    "privacyNote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No Lazyload only acts on the websites you enable. Other websites are untouched"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "No Lazyload 只作用于你启用的网站，其它网站不做任何改动"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "No Lazyload 只作用於你啟用的網站，其它網站不做任何改動"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعمل No Lazyload فقط على المواقع التي تفعّلها، ولا يمس أي موقع آخر."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "No Lazyload действа само върху сайтовете, които активирате. Останалите сайтове остават незасегнати."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "No Lazyload només actua als llocs web que activeu. La resta de llocs web no es modifiquen."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "No Lazyload působí pouze na stránky, které povolíte. Ostatní stránky zůstávají nedotčené."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "No Lazyload virker kun på de hjemmesider, du aktiverer. Andre hjemmesider berøres ikke."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "No Lazyload wirkt nur auf Websites, die du aktivierst. Andere Websites bleiben unberührt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το No Lazyload ενεργεί μόνο στους ιστότοπους που ενεργοποιείτε. Οι υπόλοιποι ιστότοποι δεν επηρεάζονται."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No Lazyload solo actúa en los sitios web que actives. Los demás sitios web no se modifican."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "No Lazyload فقط روی سایت‌هایی که فعال می‌کنید عمل می‌کند. سایر سایت‌ها دست‌نخورده می‌مانند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "No Lazyload vaikuttaa vain sivustoihin, jotka otat käyttöön. Muut sivustot jäävät ennalleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "No Lazyload n'agit que sur les sites web que vous activez. Les autres sites web ne sont pas modifiés."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "No Lazyload פועל רק באתרים שאתם מפעילים. שאר האתרים נשארים ללא שינוי."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "No Lazyload केवल उन वेबसाइटों पर कार्य करता है जिन्हें आप सक्षम करते हैं। अन्य वेबसाइटें अछूती रहती हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "No Lazyload djeluje samo na stranice koje omogućite. Ostale stranice ostaju netaknute."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A No Lazyload csak az Ön által engedélyezett webhelyeken működik. Más webhelyeket nem érint."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "No Lazyload hanya bertindak di situs web yang Anda aktifkan. Situs web lain tidak tersentuh."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "No Lazyload agisce solo sui siti web che attivi. Gli altri siti web non vengono modificati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "No Lazyload は有効にした Web サイトでのみ動作します。その他の Web サイトには何も影響しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "No Lazyload는 사용자가 활성화한 사이트에만 적용됩니다. 다른 사이트는 변경되지 않습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "No Lazyload virker bare på nettstedene du aktiverer. Andre nettsteder berøres ikke."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "No Lazyload werkt alleen op de websites die u inschakelt. Andere websites blijven onaangetast."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "No Lazyload działa tylko na stronach, które włączysz. Pozostałe strony nie są zmieniane."
          }
        },
        "ps": {
          "stringUnit": {
            "state": "translated",
            "value": "No Lazyload یوازې په هغو سایټونو عمل کوي چې تاسو یې فعالوئ. نور سایټونه بې بدلونه پاتې کیږي."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O No Lazyload atua apenas nos sites que você ativar. Os outros sites não são alterados."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "No Lazyload acționează doar asupra site-urilor pe care le activați. Celelalte site-uri rămân neatinse."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "No Lazyload работает только на сайтах, которые вы включили. Остальные сайты не затрагиваются."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "No Lazyload pôsobí iba na stránky, ktoré povolíte. Ostatné stránky zostávajú nedotknuté."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "No Lazyload agerar endast på de webbplatser du aktiverar. Andra webbplatser påverkas inte."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "No Lazyload ทำงานเฉพาะกับเว็บไซต์ที่คุณเปิดใช้งานเท่านั้น เว็บไซต์อื่นไม่ถูกแตะต้อง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "No Lazyload yalnızca etkinleştirdiğiniz web sitelerinde çalışır. Diğer web sitelerine dokunulmaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "No Lazyload діє лише на сайтах, які ви увімкнули. Інші сайти не змінюються."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "No Lazyload صرف ان سائٹس پر عمل کرتا ہے جو آپ فعال کرتے ہیں۔ باقی سائٹس میں کوئی تبدیلی نہیں کی جاتی۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "No Lazyload chỉ tác động đến những trang web bạn bật. Các trang web khác không bị ảnh hưởng."
          }
        }
      }
    },

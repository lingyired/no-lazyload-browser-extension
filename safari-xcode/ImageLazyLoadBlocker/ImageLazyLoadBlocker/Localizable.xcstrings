        },
        "el": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Άνοιξε το αναδυόμενο παράθυρο και πάτησε «Κατάργηση τρέχοντος ιστότοπου»"
          }
        },
        "es": {
          "stringUnit": {

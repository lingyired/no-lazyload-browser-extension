          }
        },
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Obre la finestra emergent i fes clic a «Elimina el lloc actual»"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Otevřete vyskakovací okno a klikněte na „Odebrat aktuální stránku“"
          }
        },
        "da": {
          "stringUnit": {

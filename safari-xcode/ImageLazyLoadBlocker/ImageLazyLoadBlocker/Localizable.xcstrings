    "appSubtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Loads every image on the sites you enable in Safari."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在你于 Safari 中启用的网站上，立即加载所有图片。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在你於 Safari 中啟用的網站上，立即載入所有圖片。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يحمّل كل الصور في المواقع التي تمكّنها في Safari."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Зарежда всички изображения в сайтовете, които разрешите в Safari."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Carrega totes les imatges dels llocs que activis al Safari."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Načte všechny obrázky na webech, které v Safari povolíte."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Indlæser alle billeder på de websteder, du aktiverer i Safari."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lädt jedes Bild auf den Websites, die du in Safari aktivierst."
          }
        },
        "el": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Φορτώνει όλες τις εικόνες στους ιστότοπους που ενεργοποιείς στο Safari."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Carga todas las imágenes de los sitios que actives en Safari."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "needs_review",
            "value": "همه تصاویر را در سایت‌هایی که در Safari فعال می‌کنید بارگذاری می‌کند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lataa kaikki kuvat niillä sivustoilla, jotka otat käyttöön Safarissa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Charge toutes les images des sites que vous activez dans Safari."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "טוען את כל התמונות באתרים שתפעיל ב-Safari."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Safari में आपके द्वारा सक्षम की गई साइटों पर सभी छवियाँ लोड करता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Učitava sve slike na web-mjestima koja omogućite u Safariju."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Betölti az összes képet azokon az oldalakon, amelyeket engedélyezel a Safariban."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Memuat semua gambar di situs yang Anda aktifkan di Safari."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Carica tutte le immagini sui siti che abiliti in Safari."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Safari で有効にしたサイトの画像をすべて読み込みます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Safari에서 활성화한 사이트의 모든 이미지를 불러옵니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Laster alle bilder på nettstedene du aktiverer i Safari."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Laadt elke afbeelding op de websites die je in Safari inschakelt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wczytuje wszystkie obrazy w witrynach włączonych w Safari."
          }
        },
        "ps": {
          "stringUnit": {
            "state": "needs_review",
            "value": "په Safari کې د هغو وېبپاڼو ټول انځورونه باروي چې تاسو یې فعالوئ."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Carrega todas as imagens nos sites que você ativar no Safari."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Încarcă toate imaginile de pe site-urile pe care le activezi în Safari."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Загружает все изображения на сайтах, которые вы включите в Safari."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Načíta všetky obrázky na weboch, ktoré v Safari povolíte."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Laddar alla bilder på de webbplatser du aktiverar i Safari."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "โหลดรูปภาพทั้งหมดบนเว็บไซต์ที่คุณเปิดใช้ใน Safari"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Safari’de etkinleştirdiğiniz sitelerdeki tüm görselleri yükler."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Завантажує всі зображення на сайтах, які ви ввімкнете в Safari."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Safari میں آپ کے فعال کردہ تمام سائٹس پر ہر تصویر لوڈ کرتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tải mọi hình ảnh trên những trang web bạn bật trong Safari."
          }
        }
      }
    },
    "enableExtensionHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {

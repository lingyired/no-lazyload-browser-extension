    "troubleshoot3Body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open the popup and click “Remove Current Site”"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开 popup，点「移除当前网站」"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟 popup，點一下「移除目前網站」"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "افتح النافذة المنبثقة واضغط «إزالة الموقع الحالي»"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "needs_review",

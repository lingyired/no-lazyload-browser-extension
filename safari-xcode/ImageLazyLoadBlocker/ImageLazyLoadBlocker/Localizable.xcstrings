    "modeCompatibilityHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scrolls the page to the bottom to trigger loading. Use it only when Standard mode does not work"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动滚动页面到底部触发加载。只在标准模式没效果时使用"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "自動捲動頁面到底部觸發載入。只在標準模式沒效果時使用"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يمرّر الصفحة إلى الأسفل لبدء التحميل. استخدمه فقط إذا لم يعمل الوضع القياسي"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Превърта страницата до дъното, което задейства зареждането. Използвайте го само ако стандартният режим не работи"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Desplaça la pàgina fins avall per activar la càrrega. Fes-lo servir només si el mode Estàndard no funciona"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Posune stránku dolů a tím spustí načítání. Použijte jen tehdy, když standardní režim nefunguje"
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ruller siden til bunden for at udløse indlæsning. Brug kun, hvis standardtilstanden ikke virker"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Scrollt die Seite nach unten, um das Laden auszulösen. Nur verwenden, wenn der Standardmodus nicht funktioniert"
          }
        },
        "el": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Κυλά τη σελίδα στο κάτω μέρος για να ξεκινήσει η φόρτωση. Χρησιμοποίησέ το μόνο αν η τυπική λειτουργία δεν δουλεύει"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Desplaza la página hasta abajo para activar la carga. Úsalo solo si el modo Estándar no funciona"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "needs_review",
            "value": "صفحه را تا پایین می‌لغزاند تا بارگذاری آغاز شود. فقط وقتی حالت استاندارد کار نکرد استفاده کنید"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vierittää sivun alas, mikä käynnistää latauksen. Käytä vain, jos vakiomuoto ei toimi"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Fait défiler la page jusqu’en bas pour déclencher le chargement. À n’utiliser que si le mode Standard ne fonctionne pas"
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "גולל את העמוד עד למטה כדי להפעיל טעינה. השתמש בזה רק אם המצב הרגיל לא עובד"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "लोडिंग शुरू करने के लिए पेज को नीचे तक स्क्रॉल करता है। सिर्फ़ तब इस्तेमाल करें जब मानक मोड काम न करे"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pomiče stranicu do dna i time pokreće učitavanje. Koristite samo ako standardni način ne radi"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Az oldal aljára lapoz, ezzel elindítja a betöltést. Csak akkor használd, ha a normál mód nem működik"
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Menggulir halaman ke bawah untuk memicu pemuatan. Pakai hanya jika mode Standar tidak berhasil"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Scorre la pagina fino in fondo per attivare il caricamento. Usalo solo se la modalità Standard non funziona"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ページを最下部までスクロールして読み込みを促します。標準モードで効果がない場合のみ使ってください"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "페이지를 아래 끝까지 스크롤해 불러오기를 유도합니다. 표준 모드가 효과 없을 때만 사용하세요"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ruller siden til bunnen for å utløse lasting. Bruk bare hvis standardmodusen ikke virker"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Scrolt de pagina naar beneden om het laden te activeren. Gebruik dit alleen als de standaardmodus niet werkt"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Przewija stronę na dół, aby wyzwolić wczytywanie. Używaj tylko wtedy, gdy tryb standardowy nie działa"
          }
        },
        "ps": {
          "stringUnit": {
            "state": "needs_review",
            "value": "د بارولو د پیل لپاره پاڼه تر ښکته سکرولوي. یوازې هغه وخت وکاروئ چې معیاري حالت کار ونکړي"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Rola a página até o fim para disparar o carregamento. Use apenas se o modo Padrão não funcionar"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Derulează pagina până jos pentru a declanșa încărcarea. Folosește-o doar dacă modul Standard nu funcționează"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Прокручивает страницу до низа, вызывая загрузку. Используйте только если стандартный режим не помогает"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Posunie stránku nadol a spustí načítavanie. Použite len vtedy, keď štandardný režim nefunguje"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Rullar sidan till botten för att utlösa laddning. Använd bara om standardläget inte fungerar"
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "เลื่อนหน้าไปล่างสุดเพื่อกระตุ้นการโหลด ใช้เฉพาะเมื่อโหมดมาตรฐานไม่ได้ผล"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Yüklemeyi tetiklemek için sayfayı en alta kaydırır. Yalnızca Standart mod işe yaramazsa kullanın"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Прокручує сторінку донизу, що запускає завантаження. Використовуйте лише якщо стандартний режим не працює"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "needs_review",
            "value": "لوڈنگ شروع کرنے کے لیے صفحہ کو نیچے تک سکرول کرتا ہے۔ صرف اُس وقت استعمال کریں جب معیاری موڈ کام نہ کرے"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cuộn trang xuống cuối để kích hoạt tải. Chỉ dùng khi chế độ Tiêu chuẩn không hiệu quả"
          }
        }
      }
    },

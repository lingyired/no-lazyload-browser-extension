    "troubleshoot2Body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check Safari → Settings → Extensions and make sure No Lazyload is on"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "到 Safari → 设置 → 扩展，确认 No Lazyload 已勾选"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "到 Safari → 設定 → 擴充功能，確認 No Lazyload 已勾選"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "افتح Safari ← الإعدادات ← الإضافات وتأكد من تشغيل No Lazyload"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Отворете Safari → Настройки → Разширения и се уверете, че No Lazyload е включено"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ves a Safari → Configuració → Extensions i assegura’t que No Lazyload estigui activada"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Přejděte do Safari → Nastavení → Rozšíření a ujistěte se, že je No Lazyload povolené"
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Gå til Safari → Indstillinger → Udvidelser, og sørg for at No Lazyload er slået til"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Prüfe Safari → Einstellungen → Erweiterungen und stelle sicher, dass No Lazyload aktiviert ist"
          }
        },
        "el": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Πήγαινε σε Safari → Ρυθμίσεις → Επεκτάσεις και βεβαιώσου ότι το No Lazyload είναι ενεργό"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ve a Safari → Ajustes → Extensiones y asegúrate de que No Lazyload esté activada"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "needs_review",
            "value": "به Safari ← تنظیمات ← افزونه‌ها بروید و مطمئن شوید No Lazyload روشن است"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tarkista Safari → Asetukset → Laajennukset ja varmista, että No Lazyload on käytössä"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vérifiez Safari → Réglages → Extensions et assurez-vous que No Lazyload est activé"
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "עבור אל Safari ← הגדרות ← תוספים וודא ש-No Lazyload מופעל"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Safari → सेटिंग → एक्सटेंशन में जाकर देखें कि No Lazyload चालू है"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Otvorite Safari → Postavke → Proširenja i provjerite je li No Lazyload uključen"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nyisd meg a Safari → Beállítások → Bővítmények menüpontot, és győződj meg róla, hogy a No Lazyload be van kapcsolva"
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Buka Safari → Pengaturan → Ekstensi dan pastikan No Lazyload aktif"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vai su Safari → Impostazioni → Estensioni e assicurati che No Lazyload sia attiva"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Safari → 設定 → 機能拡張 で No Lazyload がオンになっているか確認してください"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Safari → 설정 → 확장 기능에서 No Lazyload가 켜져 있는지 확인하세요"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Gå til Safari → Innstillinger → Utvidelser og sørg for at No Lazyload er slått på"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ga naar Safari → Instellingen → Extensies en zorg dat No Lazyload is ingeschakeld"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sprawdź Safari → Ustawienia → Rozszerzenia i upewnij się, że No Lazyload jest włączone"
          }
        },
        "ps": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Safari ← تنظیمات ← غځونکي ته لاړ شئ او ډاډ ترلاسه کړئ چې No Lazyload وچول شوی"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Verifique Safari → Ajustes → Extensões e confirme que o No Lazyload está ativado"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Verifică Safari → Setări → Extensii și asigură-te că No Lazyload este activată"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Откройте Safari → Настройки → Расширения и убедитесь, что No Lazyload включено"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Prejdite do Safari → Nastavenia → Rozšírenia a uistite sa, že je No Lazyload povolené"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Gå till Safari → Inställningar → Tillägg och se till att No Lazyload är aktiverat"
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ไปที่ Safari → การตั้งค่า → ส่วนขยาย แล้วตรวจสอบว่าเปิด No Lazyload อยู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Safari → Ayarlar → Uzantılar yolunu izleyin ve No Lazyload’ın açık olduğundan emin olun"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Відкрийте Safari → Налаштування → Розширення та переконайтеся, що No Lazyload увімкнено"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Safari ← ترتیبات ← ایکسٹینشنز میں جا کر یقینی بنائیں کہ No Lazyload آن ہے"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vào Safari → Cài đặt → Tiện ích và đảm bảo No Lazyload đã bật"
          }
        }
      }
    },

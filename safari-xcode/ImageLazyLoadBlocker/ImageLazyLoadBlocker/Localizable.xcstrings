    "troubleshoot1Body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Make sure the site is enabled in the popup. If it is, try Compatibility mode. Still nothing? Use Refresh Page"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先确认这个网站已在 popup 里启用；再试试兼容模式；还不行就用 popup 底部的「刷新页面」"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "先確認這個網站已在 popup 裡啟用；再試試相容模式；還不行就用 popup 底部的「重新整理頁面」"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تأكد من تمكين الموقع في النافذة المنبثقة. إن كان ممكّنًا، جرّب وضع التوافق. ما زال لا يعمل؟ استخدم «تحديث الصفحة»"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Проверете дали сайтът е разрешен в изскачащия прозорец. Ако е, опитайте режима за съвместимост. Все още нищо? Използвайте „Презареди страницата“"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Comprova que el lloc estigui activat a la finestra emergent. Si ho està, prova el mode Compatibilitat. Encara res? Fes servir «Actualitza la pàgina»"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zkontrolujte, zda je web povolený ve vyskakovacím okně. Pokud ano, zkuste režim kompatibility. Stále nic? Použijte „Obnovit stránku“"
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kontrollér, at webstedet er aktiveret i pop op-vinduet. Hvis det er, prøv kompatibilitetstilstanden. Stadig intet? Brug “Opdater side”"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Prüfe, ob die Website im Popup aktiviert ist. Wenn ja, probiere den Kompatibilitätsmodus. Immer noch nichts? Nutze „Seite neu laden“"
          }
        },
        "el": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Έλεγξε ότι ο ιστότοπος είναι ενεργοποιημένος στο αναδυόμενο παράθυρο. Αν είναι, δοκίμασε τη λειτουργία συμβατότητας. Ακόμα τίποτα; Χρησιμοποίησε «Ανανέωση σελίδας»"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Comprueba que el sitio esté activado en la ventana emergente. Si lo está, prueba el modo Compatibilidad. ¿Sigue sin funcionar? Usa «Actualizar página»"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "needs_review",
            "value": "بررسی کنید که سایت در پنجره بازشو فعال شده باشد. اگر فعال است، حالت سازگاری را امتحان کنید. هنوز نشد؟ از «بازخوانی صفحه» استفاده کنید"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Varmista, että sivusto on otettu käyttöön ponnahdusikkunassa. Jos on, kokeile yhteensopivuustilaa. Eikö vieläkään toimi? Käytä ”Päivitä sivu”"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vérifiez que le site est activé dans la fenêtre contextuelle. Si oui, essayez le mode Compatibilité. Toujours rien ? Utilisez « Actualiser la page »"
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ודא שהאתר מופעל בחלון הקופץ. אם כן, נסה את מצב התאימות. עדיין לא? השתמש ב״רענן עמוד״"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "देखें कि साइट पॉपअप में सक्षम है या नहीं। अगर है, तो संगतता मोड आज़माएँ। फिर भी नहीं? “पेज रीफ़्रेश करें” इस्तेमाल करें"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Provjerite je li web-mjesto omogućeno u skočnom prozoru. Ako jest, isprobajte način rada za kompatibilnost. Još uvijek ništa? Upotrijebite „Osvježi stranicu”"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ellenőrizd, hogy az oldal engedélyezve van-e a felugró ablakban. Ha igen, próbáld a kompatibilitási módot. Még mindig semmi? Használd az „Oldal frissítése” lehetőséget"
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pastikan situs sudah diaktifkan di popup. Jika sudah, coba mode Kompatibilitas. Masih tidak bisa? Pakai “Muat ulang halaman”"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Verifica che il sito sia abilitato nel popup. Se lo è, prova la modalità Compatibilità. Ancora niente? Usa «Aggiorna pagina»"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ポップアップでこのサイトが有効になっているか確認してください。有効なら互換モードを試してください。それでもだめなら「ページを再読み込み」を使ってください"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "팝업에서 이 사이트가 활성화되어 있는지 확인하세요. 활성화되어 있다면 호환 모드를 시도하세요. 그래도 안 되면 ‘페이지 새로 고침’을 사용하세요"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sjekk at nettstedet er aktivert i popup-vinduet. Hvis det er det, prøv kompatibilitetsmodusen. Fortsatt ingenting? Bruk «Oppdater siden»"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Controleer of de website in de pop-up is ingeschakeld. Zo ja, probeer de compatibiliteitsmodus. Nog steeds niets? Gebruik ‘Pagina vernieuwen’"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sprawdź, czy witryna jest włączona w oknie podręcznym. Jeśli tak, wypróbuj tryb zgodności. Nadal nic? Użyj „Odśwież stronę”"
          }
        },
        "ps": {
          "stringUnit": {
            "state": "needs_review",
            "value": "وګورئ چې وېبپاڼه په پاپ اپ کې فعاله ده که نه. که فعاله وي، مطابقت حالت وآزموئ. لا هم نه؟ «پاڼه تازه کړئ» وکاروئ"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Confirme que o site está ativado na janela pop-up. Se estiver, experimente o modo Compatibilidade. Ainda nada? Use «Atualizar página»"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Verifică dacă site-ul este activat în fereastra pop-up. Dacă da, încearcă modul Compatibilitate. Tot nimic? Folosește „Reîmprospătează pagina”"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Проверьте, включён ли сайт во всплывающем окне. Если да, попробуйте режим совместимости. Всё ещё ничего? Используйте «Обновить страницу»"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Skontrolujte, či je web povolený vo vyskakovacom okne. Ak áno, vyskúšajte režim kompatibility. Stále nič? Použite „Obnoviť stránku“"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kontrollera att webbplatsen är aktiverad i popup-fönstret. Om den är det, prova kompatibilitetsläget. Fortfarande inget? Använd ”Uppdatera sidan”"
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ตรวจสอบว่าเว็บไซต์เปิดใช้ในป๊อปอัปแล้วหรือยัง ถ้าเปิดแล้วให้ลองโหมดเข้ากันได้ ยังไม่ได้ผลใช่ไหม ใช้ “รีเฟรชหน้า”"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sitenin açılır pencerede etkinleştirildiğinden emin olun. Etkinse uyumluluk modunu deneyin. Hâlâ olmuyor mu? «Sayfayı yenile» seçeneğini kullanın"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Перевірте, чи сайт увімкнено у спливному вікні. Якщо так, спробуйте режим сумісності. Усе ще нічого? Скористайтеся «Оновити сторінку»"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "needs_review",
            "value": "دیکھیں کہ سائٹ پاپ اپ میں فعال ہے یا نہیں۔ اگر ہے تو مطابقت موڈ آزمائیں۔ پھر بھی نہیں؟ «صفحہ تازہ کریں» استعمال کریں"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kiểm tra xem trang web đã được bật trong cửa sổ bật lên chưa. Nếu rồi, thử chế độ Tương thích. Vẫn không được? Dùng “Tải lại trang”"
          }
        }
      }
    },
    "troubleshoot1Title": {
      "extractionState": "manual",
      "localizations": {
        "en": {

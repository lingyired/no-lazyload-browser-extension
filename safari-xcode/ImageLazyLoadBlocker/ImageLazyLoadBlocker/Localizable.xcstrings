    "modeStandardHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Blocks lazy loading directly. The default, and works on most sites"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "直接拦截懒加载。默认方式，绝大多数网站用这个"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "直接攔截延遲載入。預設方式，絕大多數網站用這個"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يمنع التحميل الكسول مباشرة. الوضع الافتراضي، يعمل في معظم المواقع"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Блокира директно отложеното зареждане. Режимът по подразбиране, работи в повечето сайтове"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bloqueja directament la càrrega diferida. És el mode per defecte i funciona a la majoria de llocs"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Přímo blokuje líné načítání. Výchozí režim, funguje na většině webů"
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Blokerer lazy loading direkte. Standardtilstanden, virker på de fleste websteder"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Blockiert Lazy Loading direkt. Der Standard, funktioniert auf den meisten Websites"
          }
        },
        "el": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Αποκλείει απευθείας τη νωχελική φόρτωση. Η προεπιλογή, δουλεύει στους περισσότερους ιστότοπους"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bloquea directamente la carga diferida. Es el modo predeterminado y funciona en la mayoría de los sitios"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "needs_review",
            "value": "بارگذاری تنبل را مستقیم مسدود می‌کند. حالت پیش‌فرض، در بیشتر سایت‌ها کار می‌کند"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Estää lazy loadingin suoraan. Oletusasetus, toimii useimmilla sivustoilla"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bloque directement le chargement différé. Le mode par défaut, efficace sur la plupart des sites"
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "חוסם טעינה עצלה ישירות. מצב ברירת המחדל, עובד ברוב האתרים"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "लेज़ी लोडिंग को सीधे रोकता है। डिफ़ॉल्ट मोड, ज़्यादातर साइटों पर काम करता है"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Izravno blokira lijeno učitavanje. Zadani način, radi na većini web-mjesta"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Közvetlenül blokkolja a lusta betöltést. Az alapértelmezett mód, a legtöbb oldalon működik"
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Memblokir lazy loading secara langsung. Mode bawaan, berhasil di sebagian besar situs"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Blocca direttamente il lazy loading. È la modalità predefinita e funziona sulla maggior parte dei siti"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "遅延読み込みを直接ブロックします。既定のモードで、ほとんどのサイトで効果があります"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "지연 로딩을 직접 차단합니다. 기본 모드이며 대부분의 사이트에서 작동합니다"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Blokkerer lazy loading direkte. Standardmodusen, virker på de fleste nettsteder"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Blokkeert lazy loading direct. De standaardmodus, werkt op de meeste websites"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Blokuje leniwe wczytywanie bezpośrednio. Domyślny tryb, działa w większości witryn"
          }
        },
        "ps": {
          "stringUnit": {
            "state": "needs_review",
            "value": "سست بارول مستقیم بندوي. تلوالی حالت، په ډېرو وېبپاڼو کار کوي"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bloqueia diretamente o carregamento lento. É o padrão e funciona na maioria dos sites"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Blochează direct încărcarea lentă. Modul implicit, funcționează pe majoritatea site-urilor"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Напрямую блокирует ленивую загрузку. Режим по умолчанию, работает на большинстве сайтов"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Priamo blokuje lenivé načítavanie. Predvolený režim, funguje na väčšine webov"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Blockerar lazy loading direkt. Standardläget, fungerar på de flesta webbplatser"
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "บล็อกการโหลดแบบเลื่อนเวลาโดยตรง เป็นโหมดเริ่มต้นและได้ผลกับเว็บไซต์ส่วนใหญ่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tembel yüklemeyi doğrudan engeller. Varsayılan mod, çoğu sitede çalışır"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Напряму блокує ліниве завантаження. Режим за замовчуванням, працює на більшості сайтів"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "needs_review",
            "value": "سست لوڈنگ کو براہِ راست روکتا ہے۔ طے شدہ موڈ، زیادہ تر سائٹس پر کام کرتا ہے"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chặn trực tiếp việc tải chậm. Chế độ mặc định, hiệu quả với hầu hết trang web"
          }
        }
      }
